# Copy to .env (git-ignored) and fill in. Never commit real tokens.

# Hugging Face token with write access (publish.py) or read access (serving a private adapter)
HF_TOKEN=
# HUGGINGFACE_API_KEY is accepted as an alias for HF_TOKEN

# Hub repo id of the published adapter (docker compose)
ADAPTER_ID=your-hf-username/text2sql-qwen25-1p5b-lora
